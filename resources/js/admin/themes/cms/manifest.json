        "projects.content.edit": "./Content/Edit/index.vue",
        "projects.content.list.pages": "./Content/Pages/List/index.vue",
        "projects.content.list.articles": "./Content/Articles/List/index.vue",
        "projects.content.list.categories": "./Content/Categories/List/index.vue",
        "projects.content.list.tags": "./Content/Tags/List/index.vue",
        "projects.content.list.comments": "./Content/Comments/List.vue",
        "projects.content.new.pages": "./Content/Pages/New/index.vue",
        "projects.content.new.articles": "./Content/Articles/New/index.vue",
        "projects.content.new.categories": "./Content/Categories/New/index.vue",
        "projects.content.new.tags": "./Content/Tags/New/index.vue",
        "projects.content.edit.pages": "./Content/Pages/Edit/index.vue",
        "projects.content.edit.articles": "./Content/Articles/Edit/index.vue",
        "projects.content.edit.categories": "./Content/Categories/Edit/index.vue",
        "projects.content.edit.tags": "./Content/Tags/Edit/index.vue"
