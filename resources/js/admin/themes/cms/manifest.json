{
    "name": "CMS",
    "description": "Content Management System theme with articles, pages, categories, and tags",
    "version": "1.0.0",
    "author": "Aine",
    "icon": "fa-newspaper",
    "preview_image": null,
    "design_tokens": {
        "--theme-color-primary": "#4f46e5",
        "--theme-color-primary-hover": "#4338ca",
        "--theme-color-secondary": "#64748b",
        "--theme-color-accent": "#06b6d4",
        "--theme-color-success": "#10b981",
        "--theme-color-warning": "#f59e0b",
        "--theme-color-danger": "#ef4444",
        "--theme-color-bg": "#f8fafc",
        "--theme-color-surface": "#ffffff",
        "--theme-color-text": "#1e293b",
        "--theme-color-text-muted": "#64748b",
        "--theme-color-border": "#e2e8f0",
        "--theme-radius-sm": "0.25rem",
        "--theme-radius-md": "0.375rem",
        "--theme-radius-lg": "0.5rem",
