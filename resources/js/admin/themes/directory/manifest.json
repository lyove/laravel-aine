{
    "name": "Business Directory",
    "description": "Business Directory theme with listings, categories, locations, and reviews",
    "version": "1.0.0",
    "author": "Aine",
    "icon": "fa-store",
    "preview_image": null,
    "design_tokens": {
        "--theme-color-primary": "#059669",
        "--theme-color-primary-hover": "#047857",
