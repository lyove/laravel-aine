{
    "name": "Note",
    "description": "Note theme with pages, posts, categories, and tags",
    "version": "1.0.0",
    "author": "Aine",
    "icon": "fa-sticky-note",
    "preview_image": null,
    "design_tokens": {
        "--theme-color-primary": "#7c3aed",
        "--theme-color-primary-hover": "#6d28d9",
        "--theme-color-secondary": "#78716c",
        "--theme-color-accent": "#ec4899",
        "--theme-color-success": "#22c55e",
        "--theme-color-warning": "#eab308",
        "--theme-color-danger": "#f43f5e",
        "--theme-color-bg": "#fafaf9",
        "--theme-color-surface": "#ffffff",
        "--theme-color-text": "#1c1917",
        "--theme-color-text-muted": "#78716c",
        "--theme-color-border": "#e7e5e4",
        "--theme-radius-sm": "0.25rem",
        "--theme-radius-md": "0.5rem",
        "--theme-radius-lg": "1rem",
        "--theme-font-family": "Inter, system-ui, sans-serif",
        "--theme-sidebar-width": "240px",
        "--theme-header-height": "52px"
    },
    "view_overrides": {
        "projects.index": "./Index/index.vue",
        "projects.content.list": "./Content/List.vue",
        "projects.content.list.pages": "./Content/Pages/List.vue",
        "projects.content.list.posts": "./Content/Posts/List.vue",
        "projects.content.list.categories": "./Content/Categories/List.vue",
        "projects.content.list.tags": "./Content/Tags/List.vue",
        "projects.content.new.pages": "./Content/Pages/New/index.vue",
        "projects.content.new.posts": "./Content/Posts/New/index.vue",
        "projects.content.new.categories": "./Content/Categories/New/index.vue",
        "projects.content.new.tags": "./Content/Tags/New/index.vue",
        "projects.content.edit.pages": "./Content/Pages/Edit/index.vue",
        "projects.content.edit.posts": "./Content/Posts/Edit/index.vue",
        "projects.content.edit.categories": "./Content/Categories/Edit/index.vue",
        "projects.content.edit.tags": "./Content/Tags/Edit/index.vue"
    }
}
